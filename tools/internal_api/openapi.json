{
  "openapi": "3.1.0",
  "info": {
    "title": "Internal HR/IT API",
    "description": "社員情報の照会と IT 機器申請を行う社内 API(サンプル)",
    "version": "1.0.0"
  },
  "paths": {
    "/employees/{employee_id}": {
      "get": {
        "summary": "社員情報を照会する",
        "description": "社員 ID から氏名、所属部署、上長の社員 ID を返す。",
        "operationId": "get_employee",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "employee_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Employee Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/it-requests": {
      "post": {
        "summary": "IT 機器を申請する",
        "description": "社員 ID、機器名、理由を受け取り、申請を受理して申請 ID を返す。",
        "operationId": "create_it_request",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItRequestIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItRequestOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Employee": {
        "properties": {
          "employee_id": {
            "type": "string",
            "title": "Employee Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "department": {
            "type": "string",
            "title": "Department"
          },
          "manager_id": {
            "type": "string",
            "title": "Manager Id"
          }
        },
        "type": "object",
        "required": [
          "employee_id",
          "name",
          "department",
          "manager_id"
        ],
        "title": "Employee"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItRequestIn": {
        "properties": {
          "employee_id": {
            "type": "string",
            "title": "Employee Id",
            "description": "申請者の社員 ID(例: E001)"
          },
          "device": {
            "type": "string",
            "title": "Device",
            "description": "申請する機器(例: ノート PC、モニター)"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "申請理由"
          }
        },
        "type": "object",
        "required": [
          "employee_id",
          "device",
          "reason"
        ],
        "title": "ItRequestIn"
      },
      "ItRequestOut": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "employee_id": {
            "type": "string",
            "title": "Employee Id"
          },
          "device": {
            "type": "string",
            "title": "Device"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "submitted_on": {
            "type": "string",
            "format": "date",
            "title": "Submitted On"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "employee_id",
          "device",
          "status",
          "submitted_on"
        ],
        "title": "ItRequestOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "servers": [
    {
      "url": "http://host.docker.internal:8102"
    }
  ]
}
