# Dify セルフホストの Service API ベース URL
DIFY_API_BASE=http://localhost/v1
# workflow 章の support-triage(Workflow アプリ)の API キー。langgraph_calls_dify.py が使う
DIFY_APP_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
# service.py(分類サービス)が使う Ollama。Docker の Dify からではなくホストで動かすので localhost でよい
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
