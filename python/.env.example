# Dify セルフホストの Service API ベース URL
DIFY_API_BASE=http://localhost/v1
# アプリの API キー(アプリ画面の API Access で発行、app- で始まる)
DIFY_APP_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
# ナレッジ API キー(Knowledge 画面の Service API で発行、ds- で始まる)
DIFY_KNOWLEDGE_API_KEY=ds-xxxxxxxxxxxxxxxxxxxxxxxx
# knowledge_retrieve.py が検索対象にするナレッジの ID(knowledge_ingest.py の出力)
DIFY_DATASET_ID=
# tools-mcp 章: Dify アプリを公開した MCP サーバーの URL(Access Point の MCP Server カードに表示される。URL 自体が認証情報)
DIFY_MCP_SERVER_URL=http://localhost/mcp/server/xxxxxxxxxxxxxxxx/mcp
# tools-mcp 章: Webhook Trigger ノードの本番 URL
DIFY_WEBHOOK_URL=http://localhost/triggers/webhook/xxxxxxxxxxxxxxxxxxxxxxxx
