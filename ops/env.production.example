# ------------------------------------------------------------------
# Dify 1.17.1 Community Edition を本番に出すときに差し替える変数の一覧
#
# 使い方:
#   1. vendor 側の docker/.env.example を docker/.env にコピーする
#   2. このファイルの値を参考に docker/.env の該当行を書き換える
#      (各行のコメントに「どのファイルの変数か」を書いてある)
#   3. [shared.env] と書いた変数は docker/.env.example に無い。
#      docker/envs/core-services/shared.env.example を shared.env にコピーして
#      そちらに書くか、docker/.env の末尾に追記する
#
# 値はすべてダミー。<...> の箇所を自分の値に置き換える。
# このファイルをそのまま .env として使わないこと。
# 置き場所の凡例:
#   [.env]       docker/.env.example にある(docker/.env に書く)
#   [shared.env] docker/envs/core-services/shared.env.example にある
#   [certbot.env] docker/envs/infrastructure/certbot.env.example にある
#   [両方]        docker/.env.example と envs/*.env.example の両方にある
#                 (.env の値が優先されるので、.env 側を書き換える)
# ------------------------------------------------------------------

# ===== 1. シークレット(開発用の既定値を必ず置き換える) =====
# [.env] 空のままだとストレージに .dify_secret_key を自動生成する。
#        運用開始後に変えると全ユーザーがログアウトし、ファイル URL が無効になる
SECRET_KEY=<openssl rand -base64 42 の出力>
# [両方] 同梱 PostgreSQL のパスワード(外部 DB を使う場合は接続先の値)
DB_PASSWORD=<strong-db-password>
# [両方] 同梱 Redis のパスワード
REDIS_PASSWORD=<strong-redis-password>
# [.env] REDIS_PASSWORD を変えたらここも合わせる
CELERY_BROKER_URL=redis://:<strong-redis-password>@redis:6379/1
# [両方] 同梱 Weaviate の API キー。2 行とも同じ値にする
WEAVIATE_API_KEY=<weaviate-api-key>
WEAVIATE_AUTHENTICATION_APIKEY_ALLOWED_KEYS=<weaviate-api-key>
# [.env] .env.example の既定は true。本番では false にする
WEAVIATE_AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=false
# [両方] Code / Template Transform ノードの実行環境(sandbox)の API キー。2 行とも同じ値にする
SANDBOX_API_KEY=<sandbox-api-key>
CODE_EXECUTION_API_KEY=<sandbox-api-key>
# [両方] プラグインデーモンの鍵と、プラグインから Dify API を呼ぶ内部キー
PLUGIN_DAEMON_KEY=<plugin-daemon-key>
PLUGIN_DIFY_INNER_API_KEY=<plugin-inner-api-key>
# [両方] 新 Agent(agent_backend)のトークンと JWE 鍵の元。既定値のコメントに「本番で置き換えよ」とある
DIFY_AGENT_API_TOKEN=<python -c "import secrets; print(secrets.token_urlsafe(32))" の出力>
DIFY_AGENT_SERVER_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(32))" の出力>
# [両方] local_sandbox(新 Agent のシェル実行環境)の認証トークン。既定は空
DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=<local-sandbox-token>

# ===== 2. 公開 URL =====
# [.env] すべて末尾スラッシュなし。同一オリジンなら同じ値でよい
CONSOLE_API_URL=https://dify.example.com
CONSOLE_WEB_URL=https://dify.example.com
SERVICE_API_URL=https://dify.example.com
APP_API_URL=https://dify.example.com
APP_WEB_URL=https://dify.example.com
FILES_URL=https://dify.example.com
# [.env] トリガー(Webhook)と共同編集 WebSocket の公開 URL
TRIGGER_URL=https://dify.example.com
NEXT_PUBLIC_SOCKET_URL=wss://dify.example.com
# [.env] フロントと API をサブドメインで分けるときだけ設定する(例: .example.com)
COOKIE_DOMAIN=
NEXT_PUBLIC_COOKIE_DOMAIN=

# ===== 3. ストレージ(S3 互換) =====
# [両方] 既定は opendal(ローカルファイル)
STORAGE_TYPE=s3
# [shared.env] S3 互換ストレージの接続情報
S3_ENDPOINT=https://s3.ap-northeast-1.amazonaws.com
S3_REGION=ap-northeast-1
S3_BUCKET_NAME=dify-production
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>
# [shared.env] auto / path / virtual。MinIO などパス形式が必要なものは path
S3_ADDRESS_STYLE=auto
# [shared.env] IAM ロールで認証するなら true(ACCESS_KEY / SECRET_KEY は不要)
S3_USE_AWS_MANAGED_IAM=false

# ===== 4. 外部 PostgreSQL / Redis / ベクトル DB =====
# [両方] 外部 PostgreSQL を使う場合。COMPOSE_PROFILES から postgresql を外すと同梱 DB が起動しない
DB_HOST=<rds-endpoint>
DB_PORT=5432
DB_USERNAME=dify
DB_DATABASE=dify
# [両方] 外部 Redis
REDIS_HOST=<redis-endpoint>
REDIS_PORT=6379
# [両方] ベクトル DB。weaviate / qdrant / milvus / pgvector など。変えると COMPOSE_PROFILES も変わる
VECTOR_STORE=weaviate
# [.env] 既定は ${VECTOR_STORE:-weaviate},${DB_TYPE:-postgresql},collaboration
# 外部 DB と外部ベクトル DB を使うなら同梱サービスの profile を外す(例: collaboration だけ)
COMPOSE_PROFILES=${VECTOR_STORE:-weaviate},${DB_TYPE:-postgresql},collaboration

# ===== 5. メールとログイン =====
# [shared.env] resend / smtp / sendgrid
MAIL_TYPE=smtp
MAIL_DEFAULT_SEND_FROM=Dify <no-reply@example.com>
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=<smtp-user>
SMTP_PASSWORD=<smtp-password>
SMTP_USE_TLS=true
SMTP_OPPORTUNISTIC_TLS=false
# [shared.env] 招待リンクの有効期限(時間)
INVITE_EXPIRY_HOURS=72
# [shared.env] ログイン方式。既定はメール+パスワードのみ
ENABLE_EMAIL_PASSWORD_LOGIN=true
ENABLE_EMAIL_CODE_LOGIN=false
ENABLE_SOCIAL_OAUTH_LOGIN=false
# [shared.env] 自由登録と自由なワークスペース作成は既定で無効。本番でもそのままにする
ALLOW_REGISTER=false
ALLOW_CREATE_WORKSPACE=false
# [.env] /install(初回セットアップ)を通すためのパスワード。構築後に空へ戻してよい
INIT_PASSWORD=<install-gate-password>

# ===== 6. HTTPS =====
# [.env] nginx のサーバ名と HTTPS。証明書は docker/nginx/ssl/ に置く
NGINX_SERVER_NAME=dify.example.com
NGINX_HTTPS_ENABLED=true
NGINX_SSL_CERT_FILENAME=fullchain.pem
NGINX_SSL_CERT_KEY_FILENAME=privkey.pem
# [.env] Let's Encrypt(certbot profile)を使うときだけ true
NGINX_ENABLE_CERTBOT_CHALLENGE=false
# [certbot.env] certbot profile を使うときの値。nginx 側の ${CERTBOT_DOMAIN} 補間は .env からしか読まないので .env に書く
CERTBOT_DOMAIN=dify.example.com
CERTBOT_EMAIL=ops@example.com

# ===== 7. 実行とスケーリング =====
# [両方] gunicorn(gevent)。通常は 1 プロセスで足り、WORKER_CLASS は変えない
SERVER_WORKER_AMOUNT=1
SERVER_WORKER_CLASS=gevent
SERVER_WORKER_CONNECTIONS=10
GUNICORN_TIMEOUT=360
# [両方] Celery ワーカー。自動スケールにするなら CELERY_AUTO_SCALE=true と MAX / MIN
CELERY_WORKER_AMOUNT=4
CELERY_AUTO_SCALE=false
CELERY_MAX_WORKERS=
CELERY_MIN_WORKERS=
# [shared.env] アプリ 1 つあたりの同時リクエスト上限。0 は無制限
APP_MAX_ACTIVE_REQUESTS=0

# ===== 8. ログの肥大化対策 =====
# [shared.env] ワークフロー実行ログを毎日 2:00 に削除する
WORKFLOW_LOG_CLEANUP_ENABLED=true
WORKFLOW_LOG_RETENTION_DAYS=30
# [shared.env] 会話メッセージを毎日 4:00 に削除する。日数は SANDBOX_EXPIRED_RECORDS_RETENTION_DAYS
ENABLE_CLEAN_MESSAGES=false
# [envs/core-services/sandbox.env.example] api / worker には読み込まれないので .env に書く
SANDBOX_EXPIRED_RECORDS_RETENTION_DAYS=30

# ===== 9. 監視(詳細は observability 章) =====
# [shared.env] OpenTelemetry
ENABLE_OTEL=false
OTLP_BASE_ENDPOINT=http://otel-collector:4318
# [shared.env] 統合トレーシング(1.17.0 で追加)
OPS_TRACE_UNIFIED_ENABLED=false
# [.env] Sentry
API_SENTRY_DSN=
WEB_SENTRY_DSN=

# ===== 10. ネットワーク境界 =====
# [両方] ssrf_proxy が許可するプライベート CIDR(社内 API に HTTP Request ノードから届かせたいとき)
SSRF_PROXY_ALLOW_PRIVATE_IPS=
# [両方] Code ノードの外向き通信。不要なら false
SANDBOX_ENABLE_NETWORK=true
# [.env] プラグインのリモートデバッグ用ポート 5003 がホストに公開される。本番では閉じるか localhost に限定する
EXPOSE_PLUGIN_DEBUGGING_HOST=localhost
EXPOSE_PLUGIN_DEBUGGING_PORT=5003
