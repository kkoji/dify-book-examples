# Dify 1.17.1(Docker Compose)で OpenTelemetry を有効にするときに追記する行。
#
# 置き場所: これらの変数は docker/.env.example には無く、docker/envs/core-services/shared.env.example にある。
# api / worker は env_file で envs/core-services/shared.env を読むので、shared.env の該当行を書き換えるか、
# docker/.env に追記する(.env の値が envs/*.env より優先される)。
# 変更後は docker compose up -d で api / worker / worker_beat / api_websocket を再作成する。
#
# OTel Collector(ops/otel/docker-compose.yml)が同じホストで動いている前提。
# コンテナから見たホストは host.docker.internal。

ENABLE_OTEL=true
# ベース URL。トレースは /v1/traces、メトリクスは /v1/metrics が付く(個別に変えるなら OTLP_TRACE_ENDPOINT / OTLP_METRIC_ENDPOINT)
OTLP_BASE_ENDPOINT=http://host.docker.internal:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http
# otlp 以外にするとコンソールに出力する(デバッグ用)
OTEL_EXPORTER_TYPE=otlp
# 既定 0.1(10%)。ローカルで全部見たいときは 1.0
OTEL_SAMPLING_RATE=1.0
OTEL_METRIC_EXPORT_INTERVAL=60000
# OTLP 側が Bearer 認証を求める場合
OTLP_API_KEY=
# Sentry / OTel の environment タグになる
DEPLOY_ENV=PRODUCTION
