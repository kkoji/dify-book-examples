# Langfuse ローカル環境の設定。cp .env.example .env して値を書き換える。
# SALT / ENCRYPTION_KEY / NEXTAUTH_SECRET は `openssl rand -hex 32` で作る。

NEXTAUTH_URL=http://localhost:3000
LANGFUSE_PORT=3000
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME_64_HEX_CHARS
NEXTAUTH_SECRET=CHANGEME
POSTGRES_PASSWORD=postgres
CLICKHOUSE_PASSWORD=clickhouse
MINIO_ROOT_PASSWORD=miniosecret
REDIS_AUTH=myredissecret
TELEMETRY_ENABLED=false

# 初回起動時に作られる組織 / プロジェクト / ユーザー / API キー。
# ここで決めた Public Key と Secret Key を Dify の Tracing 設定(Langfuse)に入れる。
LANGFUSE_INIT_ORG_ID=dify-book
LANGFUSE_INIT_ORG_NAME=dify-book
LANGFUSE_INIT_PROJECT_ID=support-triage
LANGFUSE_INIT_PROJECT_NAME=support-triage
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME_8_chars_or_more
